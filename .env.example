APP_ENV=development

HTTP_PORT=8090
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# "*" is fine for local dev across multiple front-ends on different ports;
# replace with an explicit comma-separated list before production.
CORS_ALLOWED_ORIGINS=*

# This service's own tables (segment/customer directory) — a separate
# database (bi-centropy) on the shared app-database container over
# external-network, not the AlefGym database itself. Ask an existing team
# member for the real value; never commit it.
DATABASE_URL=postgres://postgres:changeme@app-database:5432/bi-centropy?sslmode=disable
DB_MAX_OPEN_CONN=10
DB_MAX_IDLE_CONN=10
DB_CONN_MAX_LIFETIME=5m

# Same AlefGym production database as DATABASE_URL above — source of truth
# for customers, orders and course expiry. Ask an existing team member for
# the real value; never commit it.
ALEFGYM_DATABASE_DSN=host=app-database port=5432 dbname=AlefGym user=postgres password=changeme sslmode=disable
# Comma-separated AlefGym Users.ID values to exclude from every sync/segment
# query (known test/internal accounts — see loyalty-club-roadmap.html phase 0).
ALEFGYM_EXCLUDED_USER_IDS=

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# GapGPT (OpenAI-compatible) — classifies why an overdue customer stopped
# buying, from their own chat/ticket messages (internal/domain/analysis).
# Same provider findra/backend uses; ask an existing team member for a key.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.4

# Daily AI-analysis job. RunOnStartup defaults to false so a plain `go run`
# never silently spends GapGPT credits during development.
ANALYSIS_RUN_ON_STARTUP=false
ANALYSIS_RUN_INTERVAL=24h
