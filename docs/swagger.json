        "centropy-affilate_internal_domain_analysis.Category": {
            "type": "string",
            "enum": [
                "PROGRAM_DELAY",
                "PRICE",
                "SUPPORT_QUALITY",
                "TECHNICAL_ISSUE",
                "HEALTH_PERSONAL",
                "LOST_INTEREST",
                "UNCLEAR",
                "NO_MESSAGES"
            ],
            "x-enum-comments": {
                "HealthPersonal": "injury, illness, or personal-life reason unrelated to the product",
                "LostInterest": "no complaint at all, reads as simply gone quiet",
                "NoMessages": "customer has never sent a single chat/ticket message",
                "Price": "concerned about cost, asked for discount/installments",
                "ProgramDelay": "complained their program/diet was late or never arrived",
                "SupportQuality": "complained support/coach was slow or unhelpful",
                "TechnicalIssue": "app bugs, upload/playback errors, payment gateway errors",
                "Unclear": "messages exist but give no clear signal either way"
            },
            "x-enum-descriptions": [
                "complained their program/diet was late or never arrived",
                "concerned about cost, asked for discount/installments",
                "complained support/coach was slow or unhelpful",
                "app bugs, upload/playback errors, payment gateway errors",
                "injury, illness, or personal-life reason unrelated to the product",
                "no complaint at all, reads as simply gone quiet",
                "messages exist but give no clear signal either way",
                "customer has never sent a single chat/ticket message"
            ],
            "x-enum-varnames": [
